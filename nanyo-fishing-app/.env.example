# すべて未設定でも、APIキーなしで実データを取得して動作します。
# 設定する場合は、このファイルを .env.local にコピーしてください。

# 天気API(Open-Meteo互換)。未設定時は https://api.open-meteo.com/v1/forecast
NEXT_PUBLIC_WEATHER_API_URL=

# 波高API(Open-Meteo Marine互換)。未設定時は https://marine-api.open-meteo.com/v1/marine
NEXT_PUBLIC_MARINE_API_URL=

# 潮汐API(将来の実データ接続用)。未設定時はアプリ内の簡易調和計算(参考値)
NEXT_PUBLIC_TIDE_API_URL=

# 地図タイルURL。未設定時は OpenStreetMap
NEXT_PUBLIC_MAP_TILE_URL=

# Supabase(任意)。未設定時は端末内(localStorage)に保存
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
